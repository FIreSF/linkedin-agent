# ── Local model ──────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
LK_MODEL=qwen2.5:7b
LK_NUM_CTX=4096

# Set to 1 to test the whole pipeline without a model
LK_MOCK=0

# ── Who is writing ───────────────────────────────────────────
LK_NAME=Your Name
LK_ROLE=Security Engineer
LK_AUDIENCE=people building things in tech

# ── What you want the research digest to surface ─────────────
# Comma separated. Items matching these rank first.
LK_TOPICS=cloud security, ddos, ransomware, ai agents, identity

# ── LinkedIn API (create an app at linkedin.com/developers/apps) ──
# Products tab → add "Share on LinkedIn". Redirect URL must match exactly.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT=http://localhost:8765/callback
LK_LINKEDIN_VERSION=202610

# ── Reply safety (low activity, no ban) ──────────────────────
LK_REQUIRE_APPROVAL=1
LK_MAX_REPLIES_PER_DAY=5
LK_REPLY_SPACING_S=360
LK_QUIET_START=22
LK_QUIET_END=8
LK_WATCH_POLL_S=900
